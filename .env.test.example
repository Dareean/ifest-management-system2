# Test Environment Variables
# Copy this file to .env.test and fill in with your test Supabase project credentials

# Test Supabase Project (SEPARATE from production)
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_ANON_KEY=your-test-anon-key
TEST_SUPABASE_SERVICE_KEY=your-test-service-role-key

# Test Brevo API (use test API key or mock)
TEST_BREVO_API_KEY=your-test-brevo-api-key

# Test App URL (local dev server)
TEST_APP_URL=http://localhost:3000

# IMPORTANT: These credentials should point to a SEPARATE test database
# DO NOT use production credentials here!

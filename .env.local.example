# ============================================================
# .env.local — SUPABASE CLOUD (DEVELOPMENT)
# Isi file ini dengan kredensial Proyek Supabase Cloud khusus DEVELOPMENT/STAGING.
#
# JANGAN gunakan kredensial Supabase Cloud khusus PRODUCTION di file ini!
# Kredensial Production hanya disimpan di GitHub Secrets / Deployment settings.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key-here

# Key eksternal (opsional untuk dev)
BREVO_API_KEY=
FONNTE_API_TOKEN=
# ============================================================
# .env.local — DATABASE LOKAL (DEV)
# Salin file ini ke .env.local, lalu isi dengan Supabase LOKAL yang
# dihasilkan perintah `supabase start` (lihat `supabase status -o env`).
#
# JANGAN isi dengan kredensial produksi di file ini.
# Kredensial produksi hanya dipakai oleh deployment via GitHub Secrets.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-lokal-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-lokal-service-role-key

# Key eksternal (opsional untuk dev) — gunakan key test bila ada
BREVO_API_KEY=
FONNTE_API_TOKEN=
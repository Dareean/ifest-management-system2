# ============================================================
# CONTOH ENVIRONMENT VARIABLES
#
# STRUKTUR DATABASE (2 PROYEK SUPABASE CLOUD TERPISAH):
#   1. Development (Lokal) -> Salin ke .env.local -> Isi dengan Kredensial Supabase Cloud Dev
#   2. Production (Deployment) -> Simpan di GitHub Secrets (.github/workflows/deploy.yml) / Cloudflare Secrets
# ============================================================

# Supabase (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (secret — DO NOT commit or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Brevo (Sendinblue) — transactional emails
BREVO_API_KEY=your-brevo-api-key-here

# Fonnte — WhatsApp API (Indonesia)
FONNTE_API_TOKEN=your-fonnte-token-here

# Cron Jobs — Secret untuk protect cron endpoint
CRON_SECRET=your-random-secret-string-here

# Google Apps Script Webhook (Spreadsheet & Drive Auto-Sync)
APPSCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwXE0TGix0aNSElZhW5ShDVvMG7yrMAfSVyyqPK9ZEhRIWXhAPtILwNv_ilsxzf63BM/exec
